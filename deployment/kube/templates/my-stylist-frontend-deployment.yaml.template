apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-stylist-frontend
  namespace: ${NAMESPACE}
  labels:
    app: my-stylist-frontend
    version: "${IMAGE_TAG}"
spec:
  replicas: $REPLICAS
  selector:
    matchLabels:
      app: my-stylist-frontend
  template:
    metadata:
      labels:
        app: my-stylist-frontend
        version: "${IMAGE_TAG}"
    spec:
      containers:
      - name: my-stylist-frontend
        image: ${IMAGE_NAME}:${IMAGE_TAG}
        ports:
        - containerPort: 3000
        env:
        - name: NODE_ENV
          value: "$NODE_ENV"
        - name: PUBLIC_URL
          value: "$PUBLIC_URL"
        - name: NEXT_PUBLIC_API_URL
          value: "$NEXT_PUBLIC_API_URL"
        resources:
          requests:
            memory: "128Mi"
            cpu: "100m"
          limits:
            memory: "512Mi"
            cpu: "500m"
        livenessProbe:
          httpGet:
            path: /
            port: 3000
          initialDelaySeconds: 30
          periodSeconds: 30
          timeoutSeconds: 10
        readinessProbe:
          httpGet:
            path: /
            port: 3000
          initialDelaySeconds: 10
          periodSeconds: 10
          timeoutSeconds: 5
        imagePullPolicy: Always
      imagePullSecrets:
      - name: ghcr-secret
