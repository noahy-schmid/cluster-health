{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "JWT_SECRET",
    "NODE_ENV",
    "SALON_URL",
    "S3_URL",
    "S3_SALON_ACCESS_KEY",
    "S3_SALON_SECRET_KEY",
    "S3_WEBSITE_BUCKET_NAME",
    "S3_REGION"
  ],
  "envMode": "strict",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["@repo/eslint-config#build"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix", "@repo/eslint-config#build"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "drizzle:generate": {
      "dependsOn": ["^drizzle:generate"],
      "inputs": ["$TURBO_DEFAULT$", "**/schema.ts"],
      "outputs": ["drizzle/**"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:run": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "docker:build": {
      "cache": false,
      "dependsOn": []
    }
  }
}
