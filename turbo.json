{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["DATABASE_URL", "JWT_SECRET", "NODE_ENV", "SALON_URL"],
  "envMode": "strict",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["@repo/eslint-config#build"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix", "@repo/eslint-config#build"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "drizzle:generate": {
      "dependsOn": ["^drizzle:generate"],
      "inputs": ["$TURBO_DEFAULT$", "**/schema.ts"],
      "outputs": ["drizzle/**"]
    }
  }
}
