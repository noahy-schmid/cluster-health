{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "docker:build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "docker:push": {
      "dependsOn": ["docker:build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "helm:lint": {
      "dependsOn": ["^helm:lint"],
      "inputs": ["$TURBO_DEFAULT$", "chart/**"]
    }
  }
}
