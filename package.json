{
  "name": "apps",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "docker:build": "turbo run docker:build",
    "dev": "turbo run dev",
    "e2e:prepare": "pnpm --filter @repo/auth-domain drizzle:push && pnpm --filter @repo/salon-domain drizzle:push && pnpm --filter @repo/website-domain drizzle:push",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --check \"**/*.{ts,tsx,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test:run",
    "test:e2e": "pnpm --filter manage-salon-webpage test:e2e",
    "test:e2e:ui": "pnpm --filter manage-salon-webpage test:e2e:ui",
    "prepare": "husky install",
    "drizzle:generate": "turbo run drizzle:generate",
    "drizzle:push": "turbo run drizzle:push"
  },
  "devDependencies": {
    "@effect/language-service": "^0.77.0",
    "eslint-plugin-turbo": "^2.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=18"
  }
}
