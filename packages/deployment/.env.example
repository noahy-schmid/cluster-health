# Copy this file to .env and fill in the values for local deployment runs.
# Never commit .env to the repository.

# Coolify instance
COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=your-coolify-api-token

# Server registered in Coolify (used when creating PR environments)
COOLIFY_SERVER_UUID=

# Coolify project for ephemeral PR environments
COOLIFY_DEVELOPMENT_PROJECT_UUID=

# GitHub owner of the GHCR images (org or user name)
IMAGE_OWNER=your-github-org

# Staging application UUIDs (from Coolify → project → application URL)
COOLIFY_STAGING_MANAGE_SALON_UUID=
COOLIFY_STAGING_SALON_UUID=
COOLIFY_STAGING_MARKETING_UUID=
COOLIFY_STAGING_CALENDAR_UUID=

# Production application UUIDs
COOLIFY_PRODUCTION_MANAGE_SALON_UUID=
COOLIFY_PRODUCTION_SALON_UUID=
COOLIFY_PRODUCTION_MARKETING_UUID=
COOLIFY_PRODUCTION_CALENDAR_UUID=
