{
  "name": "@repo/website-domain",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint:fix": "eslint . --fix",
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run --watch",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/test-fixtures": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.19.8",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^3.1.4",
    "axios": "^1.13.5",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "form-data": "^4.0.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@repo/infrastructure-deployment": "workspace:*",
    "@repo/salon-domain": "workspace:*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "effect": "^3.19.16",
    "pg": "^8.18.0"
  }
}
